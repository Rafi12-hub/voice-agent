rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function getUserRole() {
      return getUserData().role;
    }
    
    function isSuperAdmin() {
      return getUserRole() == 'super_admin';
    }
    
    function isManager() {
      return getUserRole() == 'manager';
    }
    
    function isAgent() {
      return getUserRole() == 'agent';
    }

    function isMemberOfOrg(orgId) {
      return getUserData().organizationId == orgId;
    }

    // User profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin());
    }

    // Organizations
    match /organizations/{orgId} {
      allow read: if isAuthenticated() && (isMemberOfOrg(orgId) || isSuperAdmin());
      allow write: if isAuthenticated() && isSuperAdmin();
    }

    // Call Records
    match /calls/{callId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isMemberOfOrg(resource.data.organizationId));
      allow create: if isAuthenticated() && (isSuperAdmin() || isManager());
      allow update, delete: if isAuthenticated() && (isSuperAdmin() || isManager()) && isMemberOfOrg(resource.data.organizationId);
    }

    // Coaching Reports
    match /coachingReports/{reportId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() || 
        isManager() && isMemberOfOrg(resource.data.organizationId) ||
        isAgent() && request.auth.uid == resource.data.agentId
      );
      allow write: if isAuthenticated() && (isSuperAdmin() || isManager());
    }

    // Notifications
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow write: if isAuthenticated();
    }

    // Settings & Configurations
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (isSuperAdmin() || isManager());
    }
  }
}
